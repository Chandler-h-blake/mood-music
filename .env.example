# This file documents variable names only. Never place real secrets here.

# API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
MOODMUSIC_DATA_DIR=./data
# BGE-M3 weights are cached under MOODMUSIC_DATA_DIR/models/huggingface.
DATABASE_URL=postgresql+asyncpg://moodmusic:moodmusic@127.0.0.1:5432/moodmusic

# Model providers. Credentials are loaded from the operating-system credential store.
CHAT_PROVIDER=deepseek
CHAT_MODEL=deepseek-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROFILE_BATCH_SIZE=8
WEB_SEARCH_PROVIDER=

# Local connector
CONNECTOR_WS_HOST=127.0.0.1
CONNECTOR_WS_PORT=8765
CONNECTOR_ALLOWED_ORIGIN=http://127.0.0.1:3000

# Optional background worker, enabled only after the corresponding ADR is accepted.
REDIS_URL=redis://127.0.0.1:6379/0
