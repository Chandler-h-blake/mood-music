        "sourceTrackId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcetrackid",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
