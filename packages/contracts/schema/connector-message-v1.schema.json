    "PlaybackStateChangedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/PlaybackStateChangedPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "playback.stateChanged",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "PlaybackStateChangedMessage",
      "type": "object"
    },
    "PlaybackStateChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Durationms"
        },
        "errorCode": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorcode"
        },
        "playlistId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlistid"
        },
        "positionMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positionms"
        },
        "queueIndex": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queueindex"
        },
        "sourceTrackId": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcetrackid"
        },
        "status": {
          "enum": [
            "idle",
            "loading",
            "playing",
            "paused",
            "stopped",
            "ended",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PlaybackStateChangedPayload",
      "type": "object"
    },
    "TrackReference": {
      "additionalProperties": false,
      "properties": {
        "album": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
