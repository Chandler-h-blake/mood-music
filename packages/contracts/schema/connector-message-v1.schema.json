{
  "$defs": {
    "CatalogSearchCompletedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/CatalogSearchCompletedPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "catalog.searchCompleted",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "CatalogSearchCompletedMessage",
      "type": "object"
    },
    "CatalogSearchCompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/CatalogSearchResult"
          },
          "maxItems": 50,
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "title": "CatalogSearchCompletedPayload",
      "type": "object"
    },
    "CatalogSearchRequestPayload": {
      "additionalProperties": false,
      "properties": {
        "expectedTrack": {
          "$ref": "#/$defs/TrackReference"
        },
        "limit": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "query": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query",
        "expectedTrack"
      ],
      "title": "CatalogSearchRequestPayload",
      "type": "object"
    },
    "CatalogSearchRequestedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/CatalogSearchRequestPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "catalog.searchRequested",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "CatalogSearchRequestedMessage",
      "type": "object"
    },
    "CatalogSearchResult": {
      "additionalProperties": false,
      "properties": {
        "album": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Album"
        },
        "artists": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Artists",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "playable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playable"
        },
        "sourceTrackId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcetrackid",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "sourceTrackId",
        "title",
        "artists",
        "confidence"
      ],
      "title": "CatalogSearchResult",
      "type": "object"
    },
    "ConnectorHeartbeatMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/ConnectorHeartbeatPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "connector.heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "ConnectorHeartbeatMessage",
      "type": "object"
    },
    "ConnectorHeartbeatPayload": {
      "additionalProperties": false,
      "properties": {
        "activeTarget": {
          "title": "Activetarget",
          "type": "boolean"
        },
        "currentTrackId": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currenttrackid"
        },
        "installationId": {
          "format": "uuid",
          "title": "Installationid",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "installationId",
        "status",
        "activeTarget"
      ],
      "title": "ConnectorHeartbeatPayload",
      "type": "object"
    },
    "ConnectorHelloMessage": {
      "additionalProperties": false,
