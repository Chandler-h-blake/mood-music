        "payload": {
          "$ref": "#/$defs/ConnectorHelloPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "connector.hello",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "ConnectorHelloMessage",
      "type": "object"
    },
    "ConnectorHelloPayload": {
      "additionalProperties": false,
      "properties": {
        "adapterVersion": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Adapterversion",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "enum": [
              "catalog.search",
              "queue.play",
              "playback.control",
              "playback.state"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "connectorType": {
          "enum": [
            "web",
            "pc"
          ],
          "title": "Connectortype",
          "type": "string"
        },
        "connectorVersion": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Connectorversion",
          "type": "string"
        },
        "installationId": {
          "format": "uuid",
          "title": "Installationid",
          "type": "string"
        },
        "targetAppVersion": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Targetappversion",
          "type": "string"
        }
      },
      "required": [
        "installationId",
        "connectorType",
        "connectorVersion",
        "targetAppVersion",
        "adapterVersion",
        "capabilities"
      ],
      "title": "ConnectorHelloPayload",
      "type": "object"
    },
    "ConnectorWelcomeMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/ConnectorWelcomePayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "connector.welcome",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "ConnectorWelcomeMessage",
      "type": "object"
    },
    "ConnectorWelcomePayload": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "connectorType": {
          "enum": [
            "web",
            "pc"
          ],
          "title": "Connectortype",
          "type": "string"
        },
        "heartbeatIntervalSeconds": {
          "maximum": 300,
          "minimum": 5,
          "title": "Heartbeatintervalseconds",
          "type": "integer"
        },
        "negotiatedCapabilities": {
          "items": {
            "enum": [
              "catalog.search",
              "queue.play",
              "playback.control",
              "playback.state"
            ],
            "type": "string"
          },
          "title": "Negotiatedcapabilities",
          "type": "array"
        },
        "serverVersion": {
          "title": "Serverversion",
          "type": "string"
        }
      },
      "required": [
        "accepted",
        "connectorType",
        "serverVersion",
        "negotiatedCapabilities",
        "heartbeatIntervalSeconds"
      ],
      "title": "ConnectorWelcomePayload",
      "type": "object"
    },
    "PlaybackActionRequestPayload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "play",
            "pause",
            "resume",
            "next",
            "previous",
            "stop"
