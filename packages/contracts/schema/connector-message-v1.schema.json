    "PlaybackQueueAcceptedPayload": {
      "additionalProperties": false,
      "properties": {
        "acceptedTrackIds": {
          "items": {
            "type": "string"
          },
          "title": "Acceptedtrackids",
          "type": "array"
        },
        "playlistId": {
          "format": "uuid",
          "title": "Playlistid",
          "type": "string"
        },
        "rejectedTrackIds": {
          "items": {
            "type": "string"
          },
          "title": "Rejectedtrackids",
          "type": "array"
        },
        "snapshotHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshothash",
          "type": "string"
        }
      },
      "required": [
        "playlistId",
        "snapshotHash",
        "acceptedTrackIds"
      ],
      "title": "PlaybackQueueAcceptedPayload",
      "type": "object"
    },
    "PlaybackQueueRejectedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/PlaybackQueueRejectedPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "playback.queueRejected",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "PlaybackQueueRejectedMessage",
      "type": "object"
    },
    "PlaybackQueueRejectedPayload": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "connector.notReady",
            "connector.capabilityMissing",
            "connector.targetIncompatible",
            "queue.snapshotMismatch",
            "queue.trackNotFound",
            "queue.trackUnplayable",
            "queue.ambiguousTrack",
            "queue.operationFailed"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "playlistId": {
          "format": "uuid",
          "title": "Playlistid",
          "type": "string"
        },
        "snapshotHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshothash",
          "type": "string"
        }
      },
      "required": [
        "playlistId",
        "snapshotHash",
        "code",
        "message"
      ],
      "title": "PlaybackQueueRejectedPayload",
      "type": "object"
    },
    "PlaybackQueueRequestPayload": {
      "additionalProperties": false,
      "properties": {
        "playlistId": {
          "format": "uuid",
          "title": "Playlistid",
          "type": "string"
        },
        "snapshotHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshothash",
          "type": "string"
        },
        "stopAfterLast": {
          "const": true,
          "title": "Stopafterlast",
          "type": "boolean"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackReference"
          },
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "playlistId",
        "snapshotHash",
        "stopAfterLast",
        "tracks"
      ],
      "title": "PlaybackQueueRequestPayload",
      "type": "object"
    },
    "PlaybackQueueRequestedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
