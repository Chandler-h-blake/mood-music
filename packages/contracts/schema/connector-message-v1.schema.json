  "$id": "https://moodmusic.local/contracts/connector-message-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "catalog.searchCompleted": "#/$defs/CatalogSearchCompletedMessage",
      "catalog.searchRequested": "#/$defs/CatalogSearchRequestedMessage",
      "connector.heartbeat": "#/$defs/ConnectorHeartbeatMessage",
      "connector.hello": "#/$defs/ConnectorHelloMessage",
      "connector.welcome": "#/$defs/ConnectorWelcomeMessage",
      "playback.actionRequested": "#/$defs/PlaybackActionRequestedMessage",
      "playback.queueAccepted": "#/$defs/PlaybackQueueAcceptedMessage",
      "playback.queueRejected": "#/$defs/PlaybackQueueRejectedMessage",
      "playback.queueRequested": "#/$defs/PlaybackQueueRequestedMessage",
      "playback.stateChanged": "#/$defs/PlaybackStateChangedMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ConnectorHelloMessage"
    },
    {
      "$ref": "#/$defs/ConnectorWelcomeMessage"
    },
    {
      "$ref": "#/$defs/ConnectorHeartbeatMessage"
    },
    {
      "$ref": "#/$defs/CatalogSearchRequestedMessage"
    },
    {
      "$ref": "#/$defs/CatalogSearchCompletedMessage"
    },
    {
      "$ref": "#/$defs/PlaybackQueueRequestedMessage"
    },
    {
      "$ref": "#/$defs/PlaybackQueueAcceptedMessage"
    },
    {
      "$ref": "#/$defs/PlaybackQueueRejectedMessage"
    },
    {
      "$ref": "#/$defs/PlaybackActionRequestedMessage"
    },
    {
      "$ref": "#/$defs/PlaybackStateChangedMessage"
    }
  ],
  "title": "MoodMusic Connector Message v1"
}
