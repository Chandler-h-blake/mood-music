          "type": "string"
        },
        "playlistId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlistid"
        }
      },
      "required": [
        "action"
      ],
