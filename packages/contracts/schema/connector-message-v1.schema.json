    "PlaybackQueueAcceptedMessage": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/PlaybackQueueAcceptedPayload"
        },
        "protocolVersion": {
          "const": "1.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "type": {
          "const": "playback.queueAccepted",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "sentAt",
        "type",
        "payload"
      ],
      "title": "PlaybackQueueAcceptedMessage",
      "type": "object"
